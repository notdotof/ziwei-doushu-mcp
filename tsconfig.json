{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["lib/**/*.ts", "mcp/**/*.ts", "mcp/**/*.mts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "_mcp_dist", "agent-server", "data"]
}
